{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        /* Chrome Extension */
        "types": [
            "chrome"
        ],
        /* Path mapping for better module resolution */
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "popup-src/src/*"
            ],
            "@/components/*": [
                "popup-src/src/components/*"
            ],
            "@/services/*": [
                "popup-src/src/services/*"
            ],
            "@/types/*": [
                "popup-src/src/types/*"
            ]
        }
    },
    "include": [
        "popup-src/**/*",
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "popup/dist"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
